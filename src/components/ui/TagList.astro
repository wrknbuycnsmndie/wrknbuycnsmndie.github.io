---
interface TagItem {
	label: string;
	href?: string;
	active?: boolean;
	count?: number;
}

interface Props {
	items: TagItem[];
	ariaLabel?: string;
}

const { items, ariaLabel } = Astro.props;
---

{
	items.length > 0 && (
		<ul class="tag-list" aria-label={ariaLabel}>
			{items.map((item) => (
				<li>
					{item.href ? (
						<a href={item.href} aria-current={item.active ? 'page' : undefined}>
							{item.label}
							{item.count !== undefined && <span>{item.count}</span>}
						</a>
					) : (
						<span data-active={item.active ? 'true' : undefined}>
							{item.label}
							{item.count !== undefined && <span>{item.count}</span>}
						</span>
					)}
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	a,
	span {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--chip-padding-block) var(--chip-padding-inline);
		border: var(--border-width) solid var(--color-border);
		color: inherit;
		background: var(--color-surface);
		font-family: var(--font-family-code);
		line-height: 1.3;
		text-decoration: none;
	}

	a:hover,
	a[aria-current='page'],
	span[data-active='true'] {
		border-color: var(--color-secondary);
		color: var(--color-on-secondary);
		background: var(--color-secondary);
	}

	span span,
	a span {
		padding: 0;
		border: 0;
		background: transparent;
		font-size: 0.75rem;
		opacity: 0.82;
	}
</style>
