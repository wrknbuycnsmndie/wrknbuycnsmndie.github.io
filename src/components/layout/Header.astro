---
import ThemeToggle from '../theme/ThemeToggle.astro';
import LanguagePicker from '../LanguagePicker.astro';
import BurgerMenu from './BurgerMenu.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocale, useTranslations } from '../../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname;
const t = useTranslations(lang);

const links = [
	{ href: getRelativeLocaleUrl(lang, '/'), label: t('nav.home') },
	{ href: getRelativeLocaleUrl(lang, '/projects/'), label: t('nav.projects') },
	{ href: getRelativeLocaleUrl(lang, '/blog/'), label: t('nav.blog') },
	{ href: getRelativeLocaleUrl(lang, '/resume/'), label: t('nav.resume') },
	{ href: getRelativeLocaleUrl(lang, '/about/'), label: t('nav.about') },
];
---

<header class="site-header">
	<a class="site-name" href={getRelativeLocaleUrl(lang, '/')}>wrknbuycnsmndie</a>

	<div class="header-actions">
		<LanguagePicker />
		<ThemeToggle />
		<BurgerMenu currentPath={currentPath} links={links} menuLabel={t('nav.menu')} />
	</div>
</header>

<style>
	.site-header {
		display: grid;
		width: 100%;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-6);
		padding: var(--space-5) var(--page-gutter);
		border-bottom: var(--border-width) solid var(--color-border);
	}

	.site-name {
		min-width: 0;
		overflow: hidden;
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-wide);
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.header-actions {
		display: flex;
		min-width: 0;
		flex-shrink: 0;
		align-items: center;
		gap: var(--space-4);
	}

	@media (max-width: 37.5rem) {
		.site-header {
			gap: var(--space-2);
			padding-block: var(--space-3);
		}

		.header-actions {
			gap: var(--space-2);
		}
	}

	@media (max-width: 23.75rem) {
		.site-name {
			font-size: 0.875rem;
		}

		.header-actions {
			gap: var(--space-1);
		}
	}
</style>
