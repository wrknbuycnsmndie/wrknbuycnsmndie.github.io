---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocale, useTranslations } from '../i18n/utils';
import HomeSectionCard from './HomeSectionCard.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const sections = [
	{
		id: 'my-projects',
		title: t('home.projects.title'),
		body: t('home.projects.empty'),
		href: getRelativeLocaleUrl(lang, '/projects/'),
	},
	{
		id: 'my-resume',
		title: t('home.resume.title'),
		body: t('home.resume.empty'),
		href: getRelativeLocaleUrl(lang, '/resume/'),
	},
	{
		id: 'my-posts',
		title: t('home.posts.title'),
		body: t('home.posts.body'),
		href: getRelativeLocaleUrl(lang, '/blog/'),
	},
];
---

<div class="home-sections">
	{
		sections.map((section, index) => (
			<HomeSectionCard {...section} hasSeparator={index > 0} />
		))
	}
</div>

<style>
	.home-sections {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: var(--space-18);
		border: var(--border-width) solid var(--color-border-strong);
		animation: enter var(--duration-slow) var(--ease-out) both;
	}

	@media (prefers-reduced-motion: reduce) {
		.home-sections {
			animation: none;
		}
	}

	@media (max-width: 50rem) {
		.home-sections {
			grid-template-columns: 1fr;
			margin-top: var(--space-12);
		}

	}
</style>
