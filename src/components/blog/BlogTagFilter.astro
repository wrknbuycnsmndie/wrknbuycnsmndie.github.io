---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';
import type { TagSummary } from '../../lib/seo';

interface Props {
	tags: TagSummary[];
	activeTag?: string;
	locale: Locale;
	label: string;
	allLabel: string;
	moreLabel: string;
}

const { tags, activeTag, locale, label, allLabel, moreLabel } = Astro.props;
const moreText = `${moreLabel} (${tags.length})`;

const tagHref = (tag: string) => getRelativeLocaleUrl(locale, `/blog/tags/${tag}/`);
---

{
	tags.length > 0 && (
		<nav class="blog-tag-filter" aria-label={label}>
			<a
				class="tag-chip tag-chip-all"
				href={getRelativeLocaleUrl(locale, '/blog/')}
				aria-current={!activeTag ? 'page' : undefined}
			>
				{allLabel}
			</a>

			<details class="tag-more">
				<summary aria-controls="blog-tag-more-list">{moreText}</summary>
			</details>

			<div class="tag-more-list" id="blog-tag-more-list">
				{tags.map((tag) => (
					<a
						class="tag-chip"
						href={tagHref(tag.name)}
						aria-current={tag.name === activeTag ? 'page' : undefined}
					>
						#{tag.name}
						<span>{tag.count}</span>
					</a>
				))}
			</div>
		</nav>
	)
}

<style>
	.blog-tag-filter {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-2);
		max-width: 100%;
	}

	.tag-chip,
	.tag-more summary {
		display: inline-flex;
		flex: 0 0 auto;
		min-height: var(--control-height-sm);
		align-items: center;
		gap: var(--space-2);
		padding: var(--chip-padding-block) var(--chip-padding-inline);
		border: var(--border-width) solid var(--color-border);
		color: var(--color-text-muted);
		background: var(--color-surface);
		font-size: var(--font-size-sm);
		line-height: 1.3;
		text-decoration: none;
		white-space: nowrap;
	}

	.tag-chip:hover,
	.tag-chip[aria-current='page'],
	.tag-more summary:hover,
	.tag-more[open] summary {
		border-color: var(--color-secondary);
		color: var(--color-on-secondary);
		background: var(--color-secondary);
	}

	.tag-chip span {
		font-family: var(--font-family-code);
		font-size: 0.75rem;
		opacity: 0.82;
	}

	.tag-more {
		flex: 0 0 auto;
	}

	.tag-more summary {
		cursor: pointer;
		list-style: none;
	}

	.tag-more summary::after {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		margin-inline-start: var(--space-1);
		border-block-end: var(--border-width) solid currentColor;
		border-inline-end: var(--border-width) solid currentColor;
		transform: translateY(-0.12rem) rotate(45deg);
	}

	.tag-more[open] summary::after {
		transform: translateY(0.12rem) rotate(225deg);
	}

	.tag-more summary::-webkit-details-marker {
		display: none;
	}

	.tag-more-list {
		display: none;
		flex: 0 0 100%;
		flex-wrap: wrap;
		gap: var(--space-2);
		width: 100%;
		min-width: 0;
		margin-block-start: var(--space-2);
		padding: var(--space-3);
		border: var(--border-width) solid var(--color-border-strong);
		background: var(--color-surface);
	}

	.tag-more[open] + .tag-more-list {
		display: flex;
	}

	@media (max-width: 37.5rem) {
		.tag-chip,
		.tag-more summary {
			min-height: var(--control-height-sm);
			padding-inline: var(--space-2);
			font-size: 0.75rem;
		}
		.tag-more-list {
			padding: var(--space-2);
		}
	}
</style>
