---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/utils';
import BlogPostCard from './BlogPostCard.astro';

type BlogPost = CollectionEntry<'blogRu'> | CollectionEntry<'blogEn'>;

interface Props {
	posts: BlogPost[];
	locale: Locale;
	tagsLabel: string;
}

const { posts, locale, tagsLabel } = Astro.props;
const formatter = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' });
---

<div class="blog-list">
	{
		posts.map((post) => (
			<BlogPostCard
				post={post}
				locale={locale}
				formattedDate={formatter.format(post.data.createdAt)}
				tagsLabel={tagsLabel}
			/>
		))
	}
</div>

<style>
	.blog-list {
		display: grid;
		gap: var(--space-4);
	}
</style>
