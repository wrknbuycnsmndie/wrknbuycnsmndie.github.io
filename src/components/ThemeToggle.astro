---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button
	class="control theme-toggle"
	type="button"
	aria-label={t('theme.switchToDark')}
	aria-pressed="false"
	data-label-dark={t('theme.dark')}
	data-label-light={t('theme.light')}
	data-aria-dark={t('theme.switchToDark')}
	data-aria-light={t('theme.switchToLight')}
>
	<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
	</svg>
	<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="3.5"></circle>
		<path
			d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path>
	</svg>
	<span class="theme-label">{t('theme.dark')}</span>
</button>

<style>
	.theme-toggle {
		min-width: 7.25rem;
		white-space: nowrap;
	}

	.theme-icon {
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.theme-icon-sun,
	.theme-toggle[aria-pressed='true'] .theme-icon-moon {
		display: none;
	}

	.theme-toggle[aria-pressed='true'] .theme-icon-sun {
		display: block;
	}

	@media (max-width: 37.5rem) {
		.theme-toggle {
			width: 2.375rem;
			min-width: 2.375rem;
			min-height: 2.375rem;
			padding-inline: 0;
		}

		.theme-label {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.theme-icon {
			width: 1.05rem;
			height: 1.05rem;
		}
	}
</style>

<script is:inline>
	const colorScheme = matchMedia('(prefers-color-scheme: dark)');

	const getTheme = () =>
		document.documentElement.dataset.theme ?? (colorScheme.matches ? 'dark' : 'light');

	const updateThemeButton = () => {
		const button = document.querySelector('.theme-toggle');
		if (!button) return;

		const isDark = getTheme() === 'dark';
		button.setAttribute(
			'aria-label',
			isDark ? (button.dataset.ariaLight ?? 'Light') : (button.dataset.ariaDark ?? 'Dark'),
		);
		button.setAttribute('aria-pressed', String(isDark));
		const label = button.querySelector('.theme-label');
		if (label) {
			label.textContent = isDark
				? (button.dataset.labelLight ?? 'Light')
				: (button.dataset.labelDark ?? 'Dark');
		}
	};

	const initializeThemeToggle = () => {
		const button = document.querySelector('.theme-toggle');
		if (!button) return;

		updateThemeButton();
		if (button.dataset.ready) return;

		button.dataset.ready = 'true';
		button.addEventListener('click', () => {
			const root = document.documentElement;
			const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
			const applyTheme = () => {
				root.dataset.theme = nextTheme;
				localStorage.setItem('theme', nextTheme);
				updateThemeButton();
			};

			if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const bounds = button.getBoundingClientRect();
				root.style.setProperty('--theme-transition-x', `${bounds.left + bounds.width / 2}px`);
				root.style.setProperty('--theme-transition-y', `${bounds.top + bounds.height / 2}px`);
				root.classList.add('theme-transition');
				const transition = document.startViewTransition(applyTheme);
				transition.finished.finally(() => {
					root.classList.remove('theme-transition');
					root.style.removeProperty('--theme-transition-x');
					root.style.removeProperty('--theme-transition-y');
				});
			} else {
				applyTheme();
			}
		});
	};

	initializeThemeToggle();
	document.addEventListener('astro:page-load', initializeThemeToggle);
	colorScheme.addEventListener('change', () => {
		if (!localStorage.getItem('theme')) updateThemeButton();
	});
</script>
