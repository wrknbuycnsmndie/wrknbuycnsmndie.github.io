---
import { languages } from '../i18n/ui';
import { getLocale } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const path = Astro.url.pathname;
const search = Astro.url.search;
const hash = Astro.url.hash;

const toLocalePath = (locale: string) => {
	if (path.startsWith('/ru/')) return path.replace('/ru/', `/${locale}/`);
	if (path.startsWith('/en/')) return path.replace('/en/', `/${locale}/`);
	return `/${locale}/`;
};
---

<select class="control language-select" aria-label="Language">
	{
		Object.entries(languages).map(([locale, label]) => (
			<option value={`${toLocalePath(locale)}${search}${hash}`} selected={locale === lang}>
				{label}
			</option>
		))
	}
</select>

<style>
	.language-select {
		width: 7rem;
		max-width: 100%;
		cursor: pointer;
	}

	@media (max-width: 37.5rem) {
		.language-select {
			width: 6rem;
			min-height: 2rem;
			padding-inline: var(--space-2);
			font-size: 0.7rem;
		}
	}
</style>

<script is:inline>
	const setupLanguagePicker = () => {
		const select = document.querySelector('.language-select');
		if (!select || select.dataset.ready) return;

		select.dataset.ready = 'true';
		select.addEventListener('change', (event) => {
			window.location.href = event.currentTarget.value;
		});
	};

	setupLanguagePicker();
	document.addEventListener('astro:page-load', setupLanguagePicker);
</script>
