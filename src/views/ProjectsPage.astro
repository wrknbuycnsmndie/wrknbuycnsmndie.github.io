---
import type { CollectionEntry } from 'astro:content';
import ProjectList from '../components/projects/ProjectList.astro';
import PageTitleBlock from '../components/ui/PageTitleBlock.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

type Project = CollectionEntry<'projectsRu'> | CollectionEntry<'projectsEn'>;

interface Props {
	projects: Project[];
	locale?: string;
}

const { projects, locale } = Astro.props;
const lang = getLocale(locale ?? Astro.currentLocale);
const t = useTranslations(lang);
const title = t('meta.projects.title');
const description = t('meta.projects.description');
const canonicalPath = `/${lang}/projects/`;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	pageType="CollectionPage"
>
	<section class="projects-page">
		<PageTitleBlock title={t('projects.title')} lead={t('projects.body')} />

		<ProjectList
			projects={projects}
			techLabel={t('projects.techLabel')}
			linksLabel={t('projects.linksLabel')}
		/>
	</section>
</BaseLayout>

<style>
	.projects-page {
		display: grid;
		gap: var(--space-8);
		max-width: var(--container-page);
		margin-inline: auto;
	}
</style>
