---
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import type { TagSummary } from '../lib/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitleBlock from '../components/ui/PageTitleBlock.astro';
import BlogPostList from '../components/blog/BlogPostList.astro';
import BlogTagFilter from '../components/blog/BlogTagFilter.astro';
import BlogPagination from '../components/blog/BlogPagination.astro';
import { getLocale, type Locale } from '../i18n/utils';
import { getBlogPageData } from '../lib/blog/blog-page';

type BlogPost = CollectionEntry<'blogRu'> | CollectionEntry<'blogEn'>;

interface Props {
	page: Page<BlogPost>;
	tags?: TagSummary[];
	tag?: string;
	locale?: string;
	alternateUrls?: Partial<Record<Locale, string>>;
}

const { page, tags = [], tag, locale, alternateUrls } = Astro.props;
const lang = getLocale(locale ?? Astro.currentLocale);
const blogPage = getBlogPageData({ page, tags, tag, locale: lang });
---

<BaseLayout
	title={blogPage.title}
	description={blogPage.description}
	canonicalPath={blogPage.canonicalPath}
	alternateUrls={alternateUrls}
	pageType="CollectionPage"
	keywords={blogPage.activeTag ? [blogPage.activeTag] : undefined}
	about={blogPage.tagAbout}
	mainEntity={{ '@id': `${blogPage.canonicalUrl}#posts` }}
	jsonLd={blogPage.jsonLd}
>
	<section class="blog-index">
		<PageTitleBlock title={blogPage.pageTitle} lead={blogPage.pageLead} />

		<BlogTagFilter
			tags={tags}
			activeTag={blogPage.activeTag}
			locale={lang}
			label={blogPage.tagsLabel}
			allLabel={blogPage.labels.allTags}
			moreLabel={blogPage.labels.moreTags}
		/>

		<BlogPostList posts={page.data} locale={lang} tagsLabel={blogPage.tagsLabel} />

		<BlogPagination
			currentPage={page.currentPage}
			lastPage={page.lastPage}
			url={page.url}
			labels={blogPage.labels.pagination}
		/>
	</section>
</BaseLayout>

<style>
	.blog-index {
		display: grid;
		gap: var(--space-8);
		max-width: var(--container-page);
		margin-inline: auto;
	}
</style>
