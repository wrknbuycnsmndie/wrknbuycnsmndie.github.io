---
import HomeHero from '../components/HomeHero.astro';
import HomeSections from '../components/HomeSections.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const title = t('meta.home.title');
const description = t('meta.home.description');
const canonicalPath = `/${lang}/`;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
	<HomeHero />
	<HomeSections />
</BaseLayout>
