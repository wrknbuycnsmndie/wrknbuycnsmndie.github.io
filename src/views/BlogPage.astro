---
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BlogPagination from '../components/blog/BlogPagination.astro';
import BlogTagFilter from '../components/blog/BlogTagFilter.astro';
import { getLocale, useTranslations, type Locale } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, blogListSchema, type TagSummary } from '../lib/seo';

type BlogPost = CollectionEntry<'blogRu'> | CollectionEntry<'blogEn'>;

interface Props {
	page: Page<BlogPost>;
	tags?: TagSummary[];
	tag?: string;
	locale?: string;
	alternateUrls?: Partial<Record<Locale, string>>;
}

const { page, tags = [], tag, locale, alternateUrls } = Astro.props;
const lang = getLocale(locale ?? Astro.currentLocale);
const t = useTranslations(lang);
const formatter = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });
const tagsLabel = lang === 'ru' ? 'Теги' : 'Tags';
const activeTag = tag;
const selectedTag = activeTag
	? tags.find((tagSummary) => tagSummary.name === activeTag)
	: undefined;
const tagTitle = activeTag ? `${t('blog.tags.pageTitle')} #${activeTag}` : undefined;
const tagDescription = activeTag
	? `${selectedTag?.count ?? page.total} ${t('blog.tags.posts')} · ${t('blog.tags.pageDescription')} #${activeTag}. ${t('blog.body')}`
	: undefined;
const pageTitle = tagTitle ?? t('blog.title');
const normalizePathname = (pathname: string) =>
	pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : `${pathname}/`;
const currentPageSuffix =
	page.currentPage > 1
		? ` · ${t('blog.pagination.page')} ${page.currentPage} ${t('blog.pagination.of')} ${page.lastPage}`
		: '';
const title = activeTag
	? `${pageTitle} | ${t('blog.title')}${currentPageSuffix}`
	: `${pageTitle}${currentPageSuffix}`;
const description = tagDescription ?? t('meta.blog.description');
const canonicalPath = normalizePathname(page.url.current);
const canonicalUrl = absoluteUrl(canonicalPath);
const tagAbout = activeTag
	? {
			'@type': 'DefinedTerm',
			name: activeTag,
			termCode: activeTag,
			url: canonicalUrl,
		}
	: undefined;
const jsonLd = blogListSchema({
	url: canonicalUrl,
	blogUrl: absoluteUrl(getRelativeLocaleUrl(lang, '/blog/')),
	title: t('blog.title'),
	description: t('meta.blog.description'),
	listTitle: title,
	listDescription: description,
	locale: lang,
	posts: page.data.map((post) => ({
		url: absoluteUrl(getRelativeLocaleUrl(lang, `/blog/${post.id}/`)),
		title: post.data.title,
	})),
});
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	alternateUrls={alternateUrls}
	pageType="CollectionPage"
	keywords={activeTag ? [activeTag] : undefined}
	about={tagAbout}
	mainEntity={{ '@id': `${canonicalUrl}#posts` }}
	jsonLd={jsonLd}
>
	<section class="blog-index">
		<header class="blog-index-header">
			<h1>{pageTitle}</h1>
			<p>
				{
					activeTag
						? `${selectedTag?.count ?? page.total} ${t('blog.tags.posts')} · ${t('blog.body')}`
						: t('blog.body')
				}
			</p>
		</header>

		<BlogTagFilter
			tags={tags}
			activeTag={activeTag}
			locale={lang}
			label={tagsLabel}
			allLabel={t('blog.tags.all')}
			moreLabel={t('blog.tags.more')}
		/>

		<div class="blog-list">
			{
				page.data.map((post) => (
					<article class="blog-post-card">
						<p class="blog-post-card-date">
							<time datetime={post.data.createdAt.toISOString()}>
								{formatter.format(post.data.createdAt)}
							</time>
						</p>
						<h2>
							<a href={getRelativeLocaleUrl(lang, `/blog/${post.id}/`)}>{post.data.title}</a>
						</h2>
						<p class="blog-post-card-description">{post.data.description}</p>
						{post.data.tags.length > 0 && (
							<ul class="blog-post-card-tags" aria-label={tagsLabel}>
								{post.data.tags.map((tag) => (
									<li>
										<a href={getRelativeLocaleUrl(lang, `/blog/tags/${tag}/`)}>#{tag}</a>
									</li>
								))}
							</ul>
						)}
					</article>
				))
			}
		</div>

		<BlogPagination
			currentPage={page.currentPage}
			lastPage={page.lastPage}
			url={page.url}
			labels={{
				aria: t('blog.pagination.page'),
				previous: t('blog.pagination.previous'),
				next: t('blog.pagination.next'),
				page: t('blog.pagination.page'),
				of: t('blog.pagination.of'),
			}}
		/>
	</section>
</BaseLayout>

<style>
	.blog-index {
		display: grid;
		gap: var(--space-8);
		max-width: 60rem;
		margin-inline: auto;
	}

	.blog-index-header {
		display: grid;
		gap: var(--space-4);
		max-width: 44rem;
	}

	.blog-index-header p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.blog-list {
		display: grid;
		gap: var(--space-4);
	}

	.blog-post-card {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
		border: var(--border-width) solid var(--color-border-strong);
		background: var(--color-canvas);
		transition:
			transform var(--duration-fast),
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	.blog-post-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-secondary);
		box-shadow: 0 12px 30px color-mix(in srgb, var(--color-secondary) 12%, transparent);
	}

	.blog-post-card h2 a {
		color: inherit;
		text-decoration: none;
	}

	.blog-post-card h2 a:focus-visible {
		outline: var(--border-width-strong) solid var(--color-secondary);
		outline-offset: var(--space-1);
	}

	.blog-post-card-date,
	.blog-post-card-description,
	.blog-post-card-tags {
		margin: 0;
		color: var(--color-text-muted);
	}

	.blog-post-card-date {
		font-size: var(--font-size-sm);
	}

	.blog-post-card h2 {
		margin: 0;
	}

	.blog-post-card-description {
		line-height: 1.65;
	}

	.blog-post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
		font-size: var(--font-size-sm);
	}

	.blog-post-card-tags li {
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
		color: var(--color-text);
	}

	.blog-post-card-tags a {
		display: inline-flex;
		padding: var(--space-1) var(--space-3);
		color: inherit;
		text-decoration: none;
	}
</style>
