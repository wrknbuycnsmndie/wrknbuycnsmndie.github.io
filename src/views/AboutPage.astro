---
import PageTitleBlock from '../components/ui/PageTitleBlock.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const title = t('meta.about.title');
const description = t('meta.about.description');
const canonicalPath = `/${lang}/about/`;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	pageType="AboutPage"
>
	<section class="about-page">
		<PageTitleBlock title={t('about.title')} lead={t('about.body')} />
	</section>
</BaseLayout>

<style>
	.about-page {
		display: grid;
		gap: var(--space-8);
		max-width: var(--container-page);
		margin-inline: auto;
	}
</style>
