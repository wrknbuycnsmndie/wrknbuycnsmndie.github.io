---
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const sections = [
	{
		id: 'my-projects',
		index: '01',
		title: t('home.projects.title'),
		body: t('home.projects.empty'),
		href: translatePath('/projects/'),
	},
	{
		id: 'my-resume',
		index: '02',
		title: t('home.resume.title'),
		body: t('home.resume.empty'),
		href: translatePath('/resume/'),
	},
	{
		id: 'my-posts',
		index: '03',
		title: t('home.posts.title'),
		body: t('home.posts.empty'),
		href: translatePath('/blog/'),
	},
];
---

<div class="home-sections">
	{
		sections.map((section) => (
			<a id={section.id} class="home-section" href={section.href}>
				<p class="section-index">{section.index}</p>
				<h2>{section.title}</h2>
				<p class="empty-state">{section.body}</p>
			</a>
		))
	}
</div>

<style>
	.home-sections {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: var(--space-18);
		border-top: var(--border-width) solid var(--color-border-strong);
		border: var(--border-width) solid var(--color-border-strong);
		animation: enter var(--duration-slow) var(--ease-out) both;
	}

	.home-section {
		display: flex;
		min-height: 16rem;
		padding: var(--space-5);
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		transition:
			background-color var(--duration-fast),
			color var(--duration-fast),
			transform var(--duration-fast);
	}

	.home-section + .home-section {
		border-left: var(--border-width) solid var(--color-border-strong);
	}

	.home-section:hover {
		background: var(--color-secondary);
		color: var(--color-on-secondary);
	}

	.home-section:hover .section-index,
	.home-section:hover .empty-state {
		color: inherit;
	}

	.home-section:active {
		transform: translateY(1px);
	}

	.home-section:focus-visible {
		outline: var(--border-width-strong) solid var(--color-secondary);
		outline-offset: calc(var(--border-width-strong) * -1);
	}

	.section-index,
	.empty-state {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.section-index {
		font-family: var(--font-family-code);
	}

	h2 {
		margin: var(--space-4) 0 0;
	}

	.empty-state {
		margin-top: auto;
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(1.125rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-sections {
			animation: none;
		}
	}

	@media (max-width: 50rem) {
		.home-sections {
			grid-template-columns: 1fr;
			margin-top: var(--space-12);
		}

		.home-section {
			min-height: 12rem;
		}

		.home-section + .home-section {
			border-top: var(--border-width) solid var(--color-border-strong);
			border-left: 0;
		}
	}
</style>
