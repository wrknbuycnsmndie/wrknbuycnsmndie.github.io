---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="text-page">
	<h1>{title}</h1>
	<div class="prose">
		<slot />
	</div>
</section>

<style>
	.text-page,
	.prose {
		max-width: 40rem;
	}

	.prose {
		margin-top: var(--space-10);
		color: var(--color-text-muted);
		animation: enter var(--duration-slow) 80ms var(--ease-out) both;
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(1.125rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.prose {
			animation: none;
		}
	}
</style>
