---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';
import TagList from '../ui/TagList.astro';

type BlogPost = CollectionEntry<'blogRu'> | CollectionEntry<'blogEn'>;

interface Props {
	post: BlogPost;
	locale: Locale;
	formattedDate: string;
	tagsLabel: string;
}

const { post, locale, formattedDate, tagsLabel } = Astro.props;
---

<article class="blog-post-card">
	<p class="blog-post-card-date">
		<time datetime={post.data.createdAt.toISOString()}>{formattedDate}</time>
	</p>
	<h2>
		<a href={getRelativeLocaleUrl(locale, `/blog/${post.id}/`)}>{post.data.title}</a>
	</h2>
	<p class="blog-post-card-description">{post.data.description}</p>
	{
		post.data.tags.length > 0 && (
			<TagList
				ariaLabel={tagsLabel}
				items={post.data.tags.map((tag) => ({
					label: `#${tag}`,
					href: getRelativeLocaleUrl(locale, `/blog/tags/${tag}/`),
				}))}
			/>
		)
	}
</article>

<style>
	.blog-post-card {
		display: grid;
		gap: var(--space-4);
		padding: var(--card-padding);
		border: var(--border-width) solid var(--card-border-color);
		background: var(--card-background);
		transition:
			transform var(--duration-fast),
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	.blog-post-card:hover {
		transform: translateY(-2px);
		border-color: var(--card-hover-border-color);
		box-shadow: var(--card-hover-shadow);
	}

	h2 {
		margin: 0;
	}

	h2 a {
		color: inherit;
		text-decoration: none;
	}

	h2 a:focus-visible {
		outline: var(--border-width-strong) solid var(--color-secondary);
		outline-offset: var(--space-1);
	}

	.blog-post-card-date,
	.blog-post-card-description {
		margin: 0;
		color: var(--color-text-muted);
	}

	.blog-post-card-date {
		font-size: var(--font-size-sm);
	}

	.blog-post-card-description {
		line-height: 1.65;
	}
</style>
