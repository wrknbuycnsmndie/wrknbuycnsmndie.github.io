{
	"name": "wrknbuycnsmndie.github.io",
	"type": "module",
	"version": "0.0.2",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"lint": "eslint src astro.config.mjs eslint.config.js",
		"lint:fix": "eslint src astro.config.mjs eslint.config.js --fix",
		"format": "prettier --write src astro.config.mjs eslint.config.js package.json tsconfig.json README.md",
		"format:check": "prettier --check src astro.config.mjs eslint.config.js package.json tsconfig.json README.md",
		"check": "astro check",
		"validate": "npm run lint && npm run format:check && npm run check && npm run build",
		"preview": "astro preview",
		"check:sizes": "node scripts/check-page-sizes.mjs dist",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"astro": "^7.0.6",
		"temml": "^0.13.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/parser": "^8.61.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3"
	}
}
