---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import ThemeScript from '../components/theme/ThemeScript.astro';
import type { JsonLdInput, JsonLdObject, PageSchemaType } from '../lib/seo';
import { getLocale, type Locale } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	canonicalPath?: string;
	alternateUrls?: Partial<Record<Locale, string>> | false;
	pageType?: PageSchemaType;
	keywords?: string[];
	about?: JsonLdObject;
	mainEntity?: JsonLdObject;
	jsonLd?: JsonLdInput;
}

const lang = getLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={lang} transition:animate="none">
	<head>
		<SeoHead {...Astro.props}>
			<slot name="head" />
		</SeoHead>
		<ThemeScript />
		<ClientRouter />
	</head>
	<body>
		<Header />

		<main transition:animate="fade">
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		flex: 1;
		padding: var(--space-18) var(--page-gutter);
	}

	@media (max-width: 37.5rem) {
		main {
			padding-block: var(--space-12);
		}
	}
</style>
